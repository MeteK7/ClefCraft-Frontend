/* Type-checking for the Playwright suite only (npx tsc -p e2e). Playwright compiles the tests itself. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
